{
  "name": "medmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:geo": "python scripts/build_geo.py",
    "validate": "python scripts/validate_data.py",
    "e2e": "playwright test",
    "fetch:sources": "node scripts/fetch_sources.mjs",
    "build:extract": "python scripts/extract_sources.py && python scripts/extract_quota.py",
    "build:hira": "python scripts/build_hira_index.py && python scripts/match_hira.py",
    "build:data": "python scripts/build_data.py",
    "build:logos": "python scripts/build_logos.py --copy && python scripts/build_data.py",
    "build:all": "npm run build:extract && npm run build:hira && npm run build:data && npm run build:logos && npm run validate"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  }
}